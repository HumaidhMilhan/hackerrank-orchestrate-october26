# Copy to .env; never commit .env. Quotas are local limits, not granted API entitlement.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RPM=5
GEMINI_TPM=250000
GEMINI_MAX_CONCURRENCY=2
# Optional separate model overrides; both use GEMINI_MODEL by default.
# GEMINI_TEXT_MODEL=
# GEMINI_VISION_MODEL=
AUDIT_API_TIMEOUT=45
# Optional verified USD rates; leave unset rather than invent a cost estimate.
# AUDIT_INPUT_USD_PER_MILLION=
# AUDIT_OUTPUT_USD_PER_MILLION=
# AUDIT_CACHED_USD_PER_MILLION=
