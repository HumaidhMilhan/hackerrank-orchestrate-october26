# Copy to .env; never commit .env. Quotas are local limits, not granted API entitlement.
AUDIT_PROVIDER=groq
GROQ_API_KEY=
GROQ_INTENT_MODEL=openai/gpt-oss-20b
GROQ_REVIEW_MODEL=openai/gpt-oss-120b
GROQ_EVIDENCE_MODEL=qwen/qwen3.8-27b
GROQ_INTENT_CONFIDENCE=0.80
GROQ_INTENT_BATCH_SIZE=4
GROQ_MAX_RETRIES=1
GROQ_TIMEOUT=30
GROQ_MAX_CONCURRENCY=2
# Applied per model; shared model overrides use the tightest role limit.
GROQ_RPM=30
GROQ_TPM=8000
GROQ_RPD=1000
GROQ_TPD=200000
GROQ_INTENT_MAX_OUTPUT_TOKENS=512
GROQ_REVIEW_MAX_OUTPUT_TOKENS=512
GROQ_EVIDENCE_MAX_OUTPUT_TOKENS=512
GROQ_INTENT_REASONING_EFFORT=low
GROQ_REVIEW_REASONING_EFFORT=low
GROQ_EVIDENCE_REASONING_EFFORT=none
GROQ_INTENT_FORMAT=strict
GROQ_REVIEW_FORMAT=strict
GROQ_EVIDENCE_FORMAT=json
AUDIT_LOG_RESPONSE_BODY=0
# Set 1 to retain bounded, fully string-redacted response body shapes in usage diagnostics.
# Optional: GROQ_{INTENT,REVIEW,EVIDENCE}_{RPM,TPM,RPD,TPD} overrides.
# Optional intent/review FORMAT=strict or json; image evidence always uses JSON Object mode.
# Verified per-million costs can differ by model/role. Set all three for each role:
# GROQ_INTENT_INPUT_USD_PER_MILLION=
# GROQ_INTENT_OUTPUT_USD_PER_MILLION=
# GROQ_INTENT_CACHED_USD_PER_MILLION=
# Repeat for GROQ_REVIEW_... and GROQ_EVIDENCE_... .
# Gemini remains available only when AUDIT_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RPM=5
GEMINI_TPM=250000
GEMINI_MAX_CONCURRENCY=2
# Optional separate model overrides; both use GEMINI_MODEL by default.
# GEMINI_TEXT_MODEL=
# GEMINI_VISION_MODEL=
AUDIT_API_TIMEOUT=45
# Optional verified USD rates; leave unset rather than invent a cost estimate.
# AUDIT_INPUT_USD_PER_MILLION=
# AUDIT_OUTPUT_USD_PER_MILLION=
# AUDIT_CACHED_USD_PER_MILLION=
